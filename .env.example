# Public site URL (Open Graph, canonical). Example GitHub Pages project site:
# NEXT_PUBLIC_SITE_URL=https://your-org.github.io/your-repo

# Base path when the site is not at domain root (GitHub Pages project pages).
# NEXT_PUBLIC_BASE_PATH=/your-repo-name

# URL of the serverless endpoint that creates Printful orders (must not expose the Printful API key).
# Example: https://your-printful-api.vercel.app/api/printful-order
# NEXT_PUBLIC_CHECKOUT_API_URL=

# Square — donations only (see SQUARE_MIGRATION.md). Merchandise uses Printful + checkout URL above.
# NEXT_PUBLIC_SQUARE_APP_ID=
# NEXT_PUBLIC_SQUARE_LOCATION_ID=
