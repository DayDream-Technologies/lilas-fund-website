# GitHub Pages: set to /your-repo-name (e.g. /lilas-fund-website) for project site deploys.
# Leave empty for local dev and custom domain root deploys.
NEXT_PUBLIC_BASE_PATH=

# Optional: canonical site URL for Open Graph (defaults in layout if unset)
# NEXT_PUBLIC_SITE_URL=https://daydream-technologies.github.io/lilas-fund-website

# Google Calendar Integration
# See GOOGLE_CALENDAR_SETUP.md for instructions
NEXT_PUBLIC_GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
NEXT_PUBLIC_GOOGLE_CALENDAR_API_KEY=your-google-api-key

# Square Payment Integration
# See SQUARE_MIGRATION.md for instructions
NEXT_PUBLIC_SQUARE_APP_ID=your-square-app-id
NEXT_PUBLIC_SQUARE_LOCATION_ID=your-square-location-id

# Contact Form (Formspree)
# Sign up at https://formspree.io and create a form
# Replace YOUR_FORM_ID in src/app/contact/page.tsx
